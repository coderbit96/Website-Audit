{
  "name": "@website-audit/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./environment/public": {
      "types": "./dist/environment/public.d.ts",
      "import": "./dist/environment/public.js",
      "default": "./dist/environment/public.js"
    },
    "./environment/server": {
      "types": "./dist/environment/server.d.ts",
      "import": "./dist/environment/server.js",
      "default": "./dist/environment/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
