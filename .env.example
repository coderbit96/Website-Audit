# Locally installed MongoDB database
MONGODB_URI=mongodb://127.0.0.1:27017/website_audit

# Application URLs
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Google PageSpeed Insights API key. Never prefix this with NEXT_PUBLIC_.
GOOGLE_PAGESPEED_API_KEY=

# Optional Razorpay Standard Checkout. Leave the key ID and secret empty until
# you have your own Razorpay test-mode credentials. Live payments require live keys.
# The webhook secret is optional but recommended for payment.captured recovery at
# https://YOUR_DOMAIN/api/payments/webhook. This is a one-time one-month purchase.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Replace this local placeholder before authentication is enabled.
# Generate a value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-secret

# Super Admin bootstrap is intentionally opt-in. Do not commit its password or
# store it in this file. Set SUPER_ADMIN_INITIAL_PASSWORD only in the shell
# that runs `npm run admin:bootstrap`; it must use 12+ mixed-case characters.
SUPER_ADMIN_EMAIL=admin@coderbit.in

# Server-only HMAC key for anonymous audit abuse-protection identifiers.
# Generate independently for production. AUTH_SECRET is used only as a fallback.
PUBLIC_AUDIT_HASH_SECRET=

# Enable only when the app is behind a trusted proxy that overwrites forwarding headers.
PUBLIC_AUDIT_TRUST_PROXY=false

# Server-only HMAC key for all remaining authentication and authenticated-action
# rate-limit identifiers. Leave blank locally to fall back to AUTH_SECRET;
# use a distinct generated value in production. Never expose this to the browser.
RATE_LIMIT_HASH_SECRET=

# Enable only behind a trusted proxy that overwrites forwarded client headers.
RATE_LIMIT_TRUST_PROXY=false

# Manual development seed safety switch. Keep false in files and production.
# Set this to true only in the shell that runs `npm run db:seed:dev`.
DEVELOPMENT_SEED_ENABLED=false

# Reserved for a future Google provider. Google OAuth is not enabled yet.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
